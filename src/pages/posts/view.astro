---
// Old post links were /posts/view/?p=<slug>. Posts now have their own pages at /posts/<slug>/,
// so this page only forwards old links there.
import Base from "../../layouts/Base.astro";
import { url } from "../../data/site";
---

<Base title="Post" noindex>
  <main class="container-site py-20 text-sm">
    <p>This post has moved. <a class="text-signal underline" href={url("/posts/")}>See all posts</a>.</p>
  </main>
</Base>

<script is:inline define:vars={{ posts: url("/posts/") }}>
  const slug = new URLSearchParams(location.search).get("p");
  if (slug && /^[a-z0-9][a-z0-9._-]*$/i.test(slug)) location.replace(posts + slug + "/");
</script>

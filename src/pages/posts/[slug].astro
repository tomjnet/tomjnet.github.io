---
// One static page per post, rendered at build time from the content repo.
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Cta from "../../components/Cta.astro";
import Arrow from "../../components/Arrow.astro";
import { site, url } from "../../data/site";
import { formatDate, getPost, getPosts, type PostEntry } from "../../lib/content";

export async function getStaticPaths() {
  return (await getPosts()).map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: PostEntry };
const post = await getPost(entry);
if (!post) throw new Error(`Post file missing for ${entry.slug}: ${entry.file}`);
---

<Base title={post.title} description={post.summary || post.title} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.date} />
    <meta property="article:author" content={site.name} />
    {post.tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>
  <div id="top"></div>
  <Header />
  <main>
    <div class="container-site pt-8">
      <a href={url("/posts/")} class="text-[11px] font-bold uppercase tracking-[0.12em] hover:text-signal">← All posts</a>
    </div>
    <article class="container-site block pb-20">
      <header class="grid gap-8 border-b-2 border-ink pb-10 pt-8 lg:grid-cols-[1fr_280px] lg:items-end">
        <div>
          <p class="kicker">Writing</p>
          <h1 class="mt-5 break-words font-display text-[44px] uppercase leading-[0.95] sm:text-[72px] lg:text-[96px]">{post.title}</h1>
        </div>
        <div class="flex flex-col gap-4">
          <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink/60">
            <time datetime={post.date}>{formatDate(post.date)}</time>
          </p>
          <div class="flex flex-wrap gap-2">
            {
              post.tags.map((t) => (
                <a
                  href={`${url("/posts/")}?tag=${encodeURIComponent(t)}`}
                  class="border border-ink/25 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider transition hover:border-signal hover:text-signal"
                >
                  {t}
                </a>
              ))
            }
          </div>
        </div>
      </header>
      <div class="grid gap-12 pt-12 lg:grid-cols-[1fr_280px]">
        <div
          class="prose prose-lg min-w-0 max-w-3xl prose-headings:font-extrabold prose-headings:uppercase prose-headings:tracking-tight prose-a:text-signal prose-a:decoration-2 prose-blockquote:border-l-4 prose-blockquote:border-signal prose-blockquote:bg-mist prose-blockquote:py-4 prose-blockquote:text-2xl prose-blockquote:font-extrabold prose-blockquote:not-italic prose-blockquote:uppercase prose-strong:text-ink prose-img:border prose-img:border-ink/15 prose-pre:rounded-none prose-pre:bg-ink prose-li:marker:text-signal"
          set:html={post.html}
        />
        <aside class="h-fit bg-mist p-6 lg:sticky lg:top-24">
          <p class="kicker">Enjoyed it?</p>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">Tell me what you think on LinkedIn, or keep reading.</p>
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ink mt-6 w-full justify-between">
            Discuss on LinkedIn <Arrow size={12} />
          </a>
          <a
            href={url("/posts/")}
            class="mt-4 inline-flex items-center gap-2 border-b-2 border-signal pb-0.5 text-[11px] font-bold uppercase tracking-[0.12em] hover:text-signal"
          >
            More posts <Arrow size={11} />
          </a>
        </aside>
      </div>
    </article>
    <Cta />
  </main>
  <Footer />
</Base>

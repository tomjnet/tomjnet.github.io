---
import Arrow from "./Arrow.astro";
import { site, url } from "../data/site";

interface Props {
  /** Transparent header with white text over the dark home hero; turns white once the page scrolls. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const current = Astro.url.pathname.replace(/\/+$/, "/");
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, "/");
  return href === "/" ? current === target : current.startsWith(target);
};
---

<!-- Always visible. data-scrolled is set by the script below; the overlay variant uses it to switch to white. -->
<header
  data-site-header
  class:list={[
    "group/header inset-x-0 top-0 z-40 border-b transition-colors duration-300",
    overlay
      ? "fixed border-transparent text-paper data-[scrolled]:border-ink/10 data-[scrolled]:bg-paper data-[scrolled]:text-ink"
      : "sticky border-ink/10 bg-paper",
  ]}
>
  <div class="container-site flex h-[72px] items-center justify-between gap-6">
    <a href={url("/")} class="flex items-center gap-1.5 font-sans text-lg font-extrabold uppercase tracking-tight">
      {site.logo}<span class="h-2 w-2 rounded-full bg-signal"></span>
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex gap-10">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="border-b-2 border-transparent pb-1 text-[11px] font-bold uppercase tracking-[0.12em] transition hover:border-signal aria-[current=page]:border-signal"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={site.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class:list={["hidden lg:inline-flex", overlay ? "btn-signal lg:group-data-[scrolled]/header:hidden" : "btn-ink"]}
    >
      Let's talk <Arrow size={12} />
    </a>
    {
      overlay && (
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ink hidden lg:group-data-[scrolled]/header:inline-flex"
        >
          Let's talk <Arrow size={12} />
        </a>
      )
    }

    <!-- Mobile menu: <details> keeps it JS-free -->
    <details class="group lg:hidden">
      <summary
        class:list={[
          "flex h-10 cursor-pointer list-none items-center px-4 text-[11px] font-bold uppercase tracking-[0.12em] [&::-webkit-details-marker]:hidden",
          overlay ? "bg-paper text-ink group-data-[scrolled]/header:bg-ink group-data-[scrolled]/header:text-paper" : "bg-ink text-paper",
        ]}
      >
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
      </summary>
      <nav class="absolute inset-x-0 top-full bg-ink text-paper shadow-2xl" aria-label="Main mobile">
        <ul class="divide-y divide-white/10">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class="block px-4 py-5 font-display text-4xl uppercase transition hover:text-signal aria-[current=page]:text-signal sm:px-8"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-signal px-4 py-5 text-xs font-bold uppercase tracking-[0.12em] sm:px-8">
              Let's talk <Arrow />
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>

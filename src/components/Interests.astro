---
// Tech stack, grouped.
const groups = [
  { title: "Languages", items: ["C++20", "C", "Python", "Java", "COBOL", "z/Architecture Assembler"] },
  { title: "Systems", items: ["Low latency", "Concurrency", "Linux and Windows internals", "IBM z/OS", "Db2"] },
  { title: "Accelerators and ML", items: ["CUDA", "LLM fine tuning", "Compilers"] },
  { title: "Cloud", items: ["Azure", "AWS", "GCP"] },
];
---

<section id="skills" class="container-site grid gap-10 border-b border-ink/10 py-16 lg:grid-cols-[1fr_4fr] lg:gap-16">
  <div>
    <p class="kicker">Skills</p>
    <h2 class="heading-bold mt-4 text-2xl">Tech<br />stack</h2>
  </div>
  <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      groups.map((g) => (
        <div class="border-t-2 border-ink pt-4">
          <h3 class="text-[11px] font-bold uppercase tracking-[0.14em] text-signal">{g.title}</h3>
          <ul class="mt-4 space-y-2.5 text-sm font-semibold">
            {g.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))
    }
  </div>
</section>

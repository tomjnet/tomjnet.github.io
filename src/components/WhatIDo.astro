---
import PenLine from "lucide-astro/PenLine";
import FlaskConical from "lucide-astro/FlaskConical";
import Zap from "lucide-astro/Zap";
import Binary from "lucide-astro/Binary";
import Server from "lucide-astro/Server";
import { url } from "../data/site";

const items = [
  { Icon: Zap, title: "Low latency", text: "Cache lines, memory layout, and shaving microseconds.", href: url("/posts/") },
  { Icon: Binary, title: "Compilers", text: "Intermediate representations, code generation and compiler-validated LLM output.", href: url("/research/") },
  { Icon: Server, title: "Mainframe", text: "IBM z/OS, Db2, CICS, IMS, RACF, JCL, Rexx, COBOL and z/Architecture Assembler.", href: url("/#skills") },
  { Icon: FlaskConical, title: "Research", text: "Compilers, LLM code generation, numerical methods and physics engines.", href: url("/research/") },
  { Icon: PenLine, title: "Writing", text: "Essays on C++, CPUs and the systems in between.", href: url("/posts/") },
];
---

<section class="bg-mist">
  <div class="container-site py-14">
    <p class="kicker">What I do</p>
    <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      {
        items.map(({ Icon, title, text, href }) => (
          <li>
            <a href={href} class="group block">
              <Icon size={30} stroke-width={1.6} class="text-signal transition group-hover:-translate-y-0.5" />
              <h3 class="heading-bold mt-4 text-sm transition group-hover:text-signal">{title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-ink/65">{text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

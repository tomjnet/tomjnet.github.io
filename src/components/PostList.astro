---
// Posts are rendered at build time from the content repo (see src/lib/content.ts).
import Arrow from "./Arrow.astro";
import { assetUrl, formatDate, getPosts, postHref } from "../lib/content";

interface Props {
  /** Max posts to show; omit for all. */
  limit?: number;
  /** Show tag filter chips. */
  filters?: boolean;
  /** "grid": colored tiles (home). "list": numbered rows (posts page). */
  variant?: "grid" | "list";
}
const { limit, filters = false, variant = "list" } = Astro.props;

const posts = (await getPosts()).slice(0, limit);
const tags = [...new Set(posts.flatMap((p) => p.tags))].sort();

// Tile artwork cycles like the reference's featured-work grid: ink, signal red, mist.
const TILE = ["bg-ink text-paper", "bg-signal text-paper", "bg-mist text-ink"];
const tagClass = "border border-ink/25 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider";
---

<post-list>
  {
    filters && tags.length > 0 && (
      <div data-filters class="mb-8 flex flex-wrap gap-6" role="group" aria-label="Filter by tag">
        {["", ...tags].map((t) => (
          <button
            type="button"
            data-tag={t}
            aria-pressed={t === "" ? "true" : "false"}
            class="border-b-2 border-transparent pb-1 text-[11px] font-bold uppercase tracking-[0.12em] transition hover:border-ink aria-pressed:border-signal aria-pressed:text-signal"
          >
            {t || "All"}
          </button>
        ))}
      </div>
    )
  }
  {posts.length === 0 && <p class="py-10 text-sm text-ink/60">No posts yet. Check back soon.</p>}
  {
    variant === "grid" ? (
      <ul class="grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {posts.map((p, i) => (
          <li>
            <a href={postHref(p.slug)} class="group block">
              <div class={`relative aspect-[4/3] overflow-hidden ${TILE[i % TILE.length]}`}>
                {p.cover ? (
                  <img
                    src={assetUrl(p.cover)}
                    alt=""
                    loading="lazy"
                    class="absolute inset-0 h-full w-full bg-white object-contain p-3 transition duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <span class="absolute inset-0 flex items-center p-6 font-display text-4xl uppercase leading-[0.95]">{p.title}</span>
                )}
              </div>
              <p class="mt-4 text-[13px] font-extrabold uppercase leading-snug tracking-tight transition group-hover:text-signal">{p.title}</p>
              <p class="mt-1 text-xs text-ink/60">
                {formatDate(p.date)}
                {p.tags.length > 0 && ` · ${p.tags.join(", ")}`}
              </p>
            </a>
          </li>
        ))}
        {
          // Keep the home grid full while there are fewer posts than slots; one "in progress" tile is enough.
          limit && posts.length > 0 && posts.length < limit && (
            <li aria-hidden="true" class="hidden md:block">
              <div class={`relative flex aspect-[4/3] items-end p-6 ${TILE[posts.length % TILE.length]}`}>
                <span class="font-display text-3xl uppercase leading-none opacity-40">Next post<br />in progress</span>
              </div>
              <p class="mt-4 text-[13px] font-extrabold uppercase tracking-tight text-ink/40">Coming soon</p>
            </li>
          )
        }
      </ul>
    ) : (
      <ul class="border-t-2 border-ink">
        {posts.map((p, i) => (
          <li class="border-b border-ink/15" data-tags={p.tags.join("|")}>
            <a
              href={postHref(p.slug)}
              class="group grid gap-4 py-8 transition hover:bg-mist sm:grid-cols-[64px_1fr_auto] sm:gap-8 sm:px-4 lg:grid-cols-[64px_1fr_280px_auto]"
            >
              <span class="font-display text-3xl text-signal">{String(i + 1).padStart(2, "0")}</span>
              <span class="flex flex-col gap-3">
                <span class="text-xl font-extrabold uppercase leading-[1.1] tracking-tight transition group-hover:text-signal sm:text-2xl">{p.title}</span>
                {p.summary && <span class="max-w-2xl text-sm leading-relaxed text-ink/70">{p.summary}</span>}
              </span>
              <span class="flex flex-col gap-3 sm:col-start-2 lg:col-start-auto">
                <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink/60">{formatDate(p.date)}</span>
                <span class="flex flex-wrap gap-2">{p.tags.map((t) => <span class={tagClass}>{t}</span>)}</span>
              </span>
              <span class="hidden self-center transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-signal sm:block">
                <Arrow size={16} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {filters && <p data-empty class="py-10 text-sm text-ink/60" hidden>No posts with this tag.</p>}
</post-list>

<script>
  // Tag filter: the rows are already in the HTML, this only shows and hides them.
  class PostList extends HTMLElement {
    connectedCallback() {
      const box = this.querySelector<HTMLElement>("[data-filters]");
      if (!box) return;
      const apply = (tag: string) => {
        let shown = 0;
        this.querySelectorAll<HTMLElement>("li[data-tags]").forEach((li) => {
          const match = !tag || li.dataset.tags!.split("|").includes(tag);
          li.hidden = !match;
          if (match) shown++;
        });
        box.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tag === tag)));
        this.querySelector<HTMLElement>("[data-empty]")!.hidden = shown > 0;
      };
      box.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-tag]");
        if (!btn) return;
        const tag = btn.dataset.tag ?? "";
        const u = new URL(location.href);
        if (tag) u.searchParams.set("tag", tag);
        else u.searchParams.delete("tag");
        history.replaceState(null, "", u);
        apply(tag);
      });
      const initial = new URLSearchParams(location.search).get("tag");
      if (initial) apply(initial);
    }
  }

  customElements.define("post-list", PostList);
</script>
